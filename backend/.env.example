# Copy to backend/.env (git-ignored) for docker compose, and create the same keys
# in the `choreshare-secrets` Kubernetes Secret (see k8s/README.md).
# Never commit real values.

# Base64-encoded HMAC key, at least 32 random bytes. Shared by api-gateway and auth-service.
#   openssl rand -base64 48
JWT_SECRET=

# Basic-auth credentials for the Eureka registry. Use URL-safe characters only
# (they are embedded in the defaultZone URL), e.g. `openssl rand -hex 24`.
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=

# Gmail account + app password used by email-service to send invites.
MAIL_USERNAME=choresync@gmail.com
MAIL_PASSWORD=

# pgAdmin login (docker compose / in-cluster only; pgAdmin is not on the public ingress).
PGADMIN_DEFAULT_PASSWORD=
